# Blink Web Environment Configuration
# Copy this file to .env or .env.local for development

# Set to 'true' to use local Firebase Emulators (Auth 9099, RTDB 9000, Firestore 8080)
VITE_USE_FIREBASE_EMULATORS=true

# Explicit production opt-in (production Firebase access remains DISABLED unless this is 'true' with valid credentials)
VITE_ENABLE_PRODUCTION_FIREBASE=false

# Firebase Web App Config (Required for production or live testing)
VITE_FIREBASE_API_KEY=mock-api-key-for-development
VITE_FIREBASE_AUTH_DOMAIN=blink-web-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=blink-web-demo
VITE_FIREBASE_STORAGE_BUCKET=blink-web-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_URL=https://blink-web-demo-default-rtdb.firebaseio.com

# Demo & Simulation Defaults
VITE_DEMO_DEFAULT_ROOM=BLINK-DEMO
VITE_SIMULATOR_AUTO_START=false
